# model 为真实模型；rule 仅用于明确标记的 MCP 阶段联调。
NPC_MODE=model
# WebSocket: ws://127.0.0.1:8765/ws/cafe（Godot MCP Native 使用 9080）
MODEL_BASE_URL=https://api.deepseek.com
MODEL_ID=deepseek-flash
MODEL_API_KEY=
# 也支持 DEEPSEEK_API_KEY，优先 MODEL_API_KEY。
MODEL_TIMEOUT_SECONDS=25
MODEL_JSON_MODE=true
MODEL_THINKING=disabled
# 默认保存到 api/data/cafe.sqlite3；可指定独立联调数据库。
# CAFE_DB_PATH=D:/projects/coffe/api/data/cafe.sqlite3
# Web 调试台：http://127.0.0.1:8765/debug/，调试数据库与 Godot 数据分开。
# CAFE_DEBUG_DB_PATH=D:/projects/coffe/api/data/harness_debug.sqlite3
# CAFE_TRACE_DIR=D:/projects/coffe/api/logs
